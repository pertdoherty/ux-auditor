# ───────────────────────────────────────
# UX Auditor — Environment Configuration
# ───────────────────────────────────────

# OpenAI (GPT-4o Vision for AI analysis)
OPENAI_API_KEY=sk-...

# Redis (BullMQ job queue backend)
REDIS_HOST=localhost
REDIS_PORT=6379

# n8n Webhook (optional — AI analysis relay)
N8N_WEBHOOK_URL=https://astroproduct.app.n8n.cloud/webhook/ux-analysis

# API Server
API_PORT=3001

# Frontend
WEB_PORT=3000

# Crawler limits
MAX_PAGES=20
MAX_DEPTH=3
CRAWL_TIMEOUT=30000

# Analysis
AI_PROVIDER=openai
